# Copy to .env and adjust. Do not commit .env.

# Base folder for server data and configuration. Must be an absolute path.
# Created subfolders: $SERVER_PATH/data (game files) and $SERVER_PATH/config.
SERVER_PATH=/path/to/ttt-classic

# User and group that own the files and run the game (non-root).
PUID=1000
PGID=1000

# Public game port (UDP and TCP).
SERVER_PORT=27015

# Steam voice port (UDP). Must be open in your firewall and published by
# Docker. It is also written into server.cfg as ttt_steam_voice_port.
# If you run more than one TTT server on a host, give each a UNIQUE port.
VOICE_PORT=27030

# Gameplay defaults.
START_MAP=ttt_pinned
MAX_PLAYERS=24

# Container name shown in Docker and Portainer.
CONTAINER_NAME=ttt-classic

# Check Steam for updates on every container start. Set to 0 to disable.
UPDATE_ON_START=1

# Give up on a slow Steam download after this many seconds and start the
# already-installed release instead. The install is ~1 GB.
UPDATE_TIMEOUT_SECONDS=900

# SteamCMD image. Pinned by digest in docker-compose.yml by default.
# Override with a tag or digest, for example:
# STEAMCMD_IMAGE=cm2network/steamcmd:root
# STEAMCMD_IMAGE=gameservermanagers/steamcmd:latest

# Dedicated server AppID on Steam (free, anonymous download).
SERVER_APPID=4753110

# Client AppID. Written to steam_appid.txt so clients can find the server.
# Do not change unless Valve/the developer reassigns it.
CLIENT_APPID=4570530

# Mod folder name, used as -game <dir>.
GAME_DIR=ttt
